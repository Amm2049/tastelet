# Copy to .env and fill in. Never commit .env.

# Only needed to re-run notebooks/01_data_prep.ipynb (in Colab it is read from the
# "TMDB_API_KEY" Colab secret). The running app never calls TMDB.
TMDB_API_KEY=

# Backend: comma-separated origins allowed by CORS (set to the Vercel URL when deployed).
ALLOWED_ORIGINS=http://localhost:5173

# Frontend settings live in frontend/.env.example (VITE_API_URL).
